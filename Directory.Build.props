<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SourceLink 在无 git 仓库时仅警告，不阻断本地 pack -->
    <WarningsNotAsErrors>NU1900;CS1591</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <Authors>Mokode</Authors>
    <Company>IndustrialComm</Company>
    <Copyright>Copyright (c) Mokode</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Mokode-dev/IndustrialComm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mokode-dev/IndustrialComm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>industrial;plc;modbus;opcua;scada;iot;communication</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
